
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA"
    tools:context=".Register">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- BRAND HEADER -->
            <RelativeLayout
                android:id="@+id/register_header"
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:background="@drawable/register_modern_header"
                android:padding="16dp">

                <TextView
                    android:id="@+id/register_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="19dp"
                    android:fontFamily="serif"
                    android:text="ChaChix"
                    android:textColor="#762943"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/register_brand_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/register_brand"
                    android:layout_centerHorizontal="true"
                    android:letterSpacing="0.3"
                    android:text="SCENTS"
                    android:textColor="#B35474"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/register_brand_subtitle"
                    android:layout_marginTop="9dp"
                    android:gravity="center"
                    android:text="Your signature scent begins here"
                    android:textColor="#815767"
                    android:textSize="12sp" />

            </RelativeLayout>

            <!-- ACCOUNT INFORMATION CARD -->
            <RelativeLayout
                android:id="@+id/account_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/register_modern_card"
                android:elevation="2dp"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/register_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Create your account"
                        android:textColor="#63263E"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Enter your details to start shopping"
                        android:textColor="#8B7982"
                        android:textSize="12sp" />

                    <!-- NAME AND EMAIL -->
                    <RelativeLayout
                        android:id="@+id/name_email_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp">

                        <View
                            android:id="@+id/name_column_center"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/full_name_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:labelFor="@id/full_name"
                                android:text="Full name"
                                android:textColor="#49323D"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/full_name"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="7dp"
                                android:background="@drawable/register_modern_input"
                                android:backgroundTint="@null"
                                android:autofillHints="name"
                                android:hint="Enter your full name"
                                android:imeOptions="actionNext"
                                android:inputType="textPersonName|textCapWords"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:singleLine="true"
                                android:textColor="#352530"
                                android:textColorHint="#A2939C"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/email_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:labelFor="@id/email"
                                android:text="Email address"
                                android:textColor="#49323D"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/email"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="7dp"
                                android:background="@drawable/register_modern_input"
                                android:backgroundTint="@null"
                                android:autofillHints="emailAddress"
                                android:hint="you@example.com"
                                android:imeOptions="actionNext"
                                android:inputType="textEmailAddress"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:singleLine="true"
                                android:textColor="#352530"
                                android:textColorHint="#A2939C"
                                android:textSize="14sp" />

                        </LinearLayout>
                    </RelativeLayout>

                    <!-- PHONE AND PASSWORD -->
                    <RelativeLayout
                        android:id="@+id/password_phone_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <View
                            android:id="@+id/password_column_center"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/phone_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:labelFor="@id/phone"
                                android:text="Phone number"
                                android:textColor="#49323D"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/phone"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="7dp"
                                android:background="@drawable/register_modern_input"
                                android:backgroundTint="@null"
                                android:autofillHints="phone"
                                android:hint="09xxxxxxxxx"
                                android:imeOptions="actionNext"
                                android:inputType="phone"
                                android:maxLength="11"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:singleLine="true"
                                android:textColor="#352530"
                                android:textColorHint="#A2939C"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/new_password_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:labelFor="@id/new_password"
                                android:text="Password"
                                android:textColor="#49323D"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/new_password"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="7dp"
                                android:background="@drawable/register_modern_input"
                                android:backgroundTint="@null"
                                android:autofillHints="newPassword"
                                android:hint="Create a password"
                                android:imeOptions="actionNext"
                                android:inputType="textPassword"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:singleLine="true"
                                android:textColor="#352530"
                                android:textColorHint="#A2939C"
                                android:textSize="14sp" />

                        </LinearLayout>
                    </RelativeLayout>

                    <!-- CONFIRM PASSWORD -->
                    <TextView
                        android:id="@+id/confirm_password_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@id/confirm_password"
                        android:text="Confirm password"
                        android:textColor="#49323D"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/register_modern_input"
                        android:backgroundTint="@null"
                        android:autofillHints="newPassword"
                        android:hint="Re-enter your password"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:textColor="#352530"
                        android:textColorHint="#A2939C"
                        android:textSize="14sp" />

                </LinearLayout>
            </RelativeLayout>

            <!-- DELIVERY ADDRESS CARD -->
            <RelativeLayout
                android:id="@+id/address_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/register_modern_card"
                android:elevation="2dp"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ADDRESS HEADING -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/address_icon"
                            android:layout_width="24dp"
                            android:layout_height="28dp"
                            android:contentDescription=""
                            android:importantForAccessibility="no"
                            android:src="@drawable/register_location_pin"
                            app:tint="#DB4B78" />

                        <TextView
                            android:id="@+id/address_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:text="Delivery address"
                            android:textColor="#63263E"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/address_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Where should we deliver your orders?"
                        android:textColor="#8B7982"
                        android:textSize="12sp" />

                    <!-- STREET -->
                    <TextView
                        android:id="@+id/street_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:labelFor="@id/street"
                        android:text="Street / building / house number"
                        android:textColor="#49323D"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/street"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/register_modern_input"
                        android:backgroundTint="@null"
                        android:autofillHints="postalAddress"
                        android:hint="e.g. Rizal St., House 12"
                        android:imeOptions="actionNext"
                        android:inputType="textPostalAddress"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:textColor="#352530"
                        android:textColorHint="#A2939C"
                        android:textSize="14sp" />

                    <!-- PROVINCE -->
                    <TextView
                        android:id="@+id/province_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@id/province"
                        android:text="Province / region"
                        android:textColor="#49323D"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/province"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/register_modern_input"
                        android:backgroundTint="@null"
                        android:hint="e.g. Davao del Sur"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:textColor="#352530"
                        android:textColorHint="#A2939C"
                        android:textSize="14sp" />

                    <!-- CITY -->
                    <TextView
                        android:id="@+id/city_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@id/city"
                        android:text="City / municipality"
                        android:textColor="#49323D"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/city"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/register_modern_input"
                        android:backgroundTint="@null"
                        android:hint="e.g. Davao City"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:textColor="#352530"
                        android:textColorHint="#A2939C"
                        android:textSize="14sp" />

                    <!-- ZIP CODE -->
                    <TextView
                        android:id="@+id/zip_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@id/zip_code"
                        android:text="ZIP code"
                        android:textColor="#49323D"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/zip_code"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/register_modern_input"
                        android:backgroundTint="@null"
                        android:autofillHints="postalCode"
                        android:hint="e.g. 8000"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="4"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:textColor="#352530"
                        android:textColorHint="#A2939C"
                        android:textSize="14sp" />

                    <!-- TERMS -->
                    <CheckBox
                        android:id="@+id/terms_checkbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:buttonTint="#D84978"
                        android:minHeight="48dp"
                        android:text="I agree to the Terms and Conditions"
                        android:textColor="#65515E"
                        android:textSize="12sp" />

                    <!-- SIGN UP BUTTON -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/signup_button"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/register_modern_button"
                        android:backgroundTint="@null"
                        app:backgroundTint="@null"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="Create account"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- LOGIN LINK -->
                    <TextView
                        android:id="@+id/login_link"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Already have an account? Log in"
                        android:textColor="#C3436B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
