<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chachix_background"
    tools:context=".cart">

    <!-- Bottom navigation -->
    <RelativeLayout
        android:id="@+id/cart_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/cart_white_background">

        <View
            android:id="@+id/nav_center"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerInParent="true" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/nav_center">

            <View
                android:id="@+id/nav_left_center"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_centerInParent="true" />

            <ImageButton
                android:id="@+id/cart_nav_home"
                style="@style/CartNavigationIcon"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/nav_left_center"
                android:contentDescription="Home"
                android:src="@drawable/ic_home" />

            <ImageButton
                android:id="@+id/cart_nav_perfumes"
                style="@style/CartNavigationIcon"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/nav_left_center"
                android:contentDescription="Perfumes"
                android:src="@drawable/ic_gift" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/nav_center">

            <View
                android:id="@+id/nav_right_center"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_centerInParent="true" />

            <ImageButton
                android:id="@+id/cart_nav_cart"
                style="@style/CartNavigationIcon"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/nav_right_center"
                android:contentDescription="Cart"
                android:src="@drawable/ic_cart" />

            <ImageButton
                android:id="@+id/cart_nav_profile"
                style="@style/CartNavigationIcon"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/nav_right_center"
                android:contentDescription="Profile"
                android:src="@drawable/ic_profile" />

        </RelativeLayout>

    </RelativeLayout>

    <!-- Scrollable cart content -->
    <ScrollView
        android:id="@+id/cart_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/cart_navigation"
        android:fillViewport="true"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/cart_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/cart_back_background"
                android:contentDescription="Back"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                android:tint="#FF89A3" />

            <TextView
                android:id="@+id/cart_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="ChaChix\nScents"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cart_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/cart_brand"
                android:layout_marginTop="18dp"
                android:fontFamily="serif"
                android:text="View Cart"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cart_subheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/cart_heading"
                android:text="Your Favorite scents are waiting!"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Saved products are added here by cart.java -->
            <RelativeLayout
                android:id="@+id/cart_products"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/cart_subheading"
                android:layout_marginTop="16dp"
                android:background="@drawable/cart_white_background"
                android:padding="10dp">

                <RelativeLayout
                    android:id="@+id/cart_items_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/cart_empty"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_below="@id/cart_items_container"
                    android:gravity="center"
                    android:text="Your cart is empty"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </RelativeLayout>

            <!-- Order summary -->
            <RelativeLayout
                android:id="@+id/cart_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/cart_products"
                android:layout_marginTop="20dp"
                android:background="@drawable/cart_white_background"
                android:padding="16dp">

                <TextView
                    android:id="@+id/summary_heading"
                    style="@style/CartSummaryHeading"
                    android:text="Order Summary" />

                <TextView
                    android:id="@+id/product_subtotal_label"
                    style="@style/CartSummaryLabel"
                    android:layout_below="@id/summary_heading"
                    android:layout_marginTop="10dp"
                    android:text="Product subtotal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cart_subtotal"
                    style="@style/CartSummaryAmount"
                    android:layout_alignTop="@id/product_subtotal_label"
                    android:text="₱0.00"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/original_label"
                    style="@style/CartSummaryLabel"
                    android:layout_below="@id/product_subtotal_label"
                    android:text="Original price" />

                <TextView
                    android:id="@+id/cart_original"
                    style="@style/CartSummaryAmount"
                    android:layout_alignTop="@id/original_label"
                    android:text="₱0.00" />

                <TextView
                    android:id="@+id/discount_label"
                    style="@style/CartSummaryLabel"
                    android:layout_below="@id/original_label"
                    android:text="Product discount" />

                <TextView
                    android:id="@+id/cart_discount"
                    style="@style/CartSummaryAmount"
                    android:layout_alignTop="@id/discount_label"
                    android:text="-₱0.00"
                    android:textColor="#FF4149" />

                <TextView
                    android:id="@+id/shipping_heading"
                    style="@style/CartSummaryHeading"
                    android:layout_below="@id/discount_label"
                    android:layout_marginTop="12dp"
                    android:text="Shipping subtotal" />

                <TextView
                    android:id="@+id/shipping_label"
                    style="@style/CartSummaryLabel"
                    android:layout_below="@id/shipping_heading"
                    android:layout_marginTop="4dp"
                    android:text="Shipping fee" />

                <TextView
                    android:id="@+id/cart_shipping"
                    style="@style/CartSummaryAmount"
                    android:layout_alignTop="@id/shipping_label"
                    android:text="₱0.00" />

                <TextView
                    android:id="@+id/shipping_discount_label"
                    style="@style/CartSummaryLabel"
                    android:layout_below="@id/shipping_label"
                    android:text="Shipping discount" />

                <TextView
                    android:id="@+id/cart_shipping_discount"
                    style="@style/CartSummaryAmount"
                    android:layout_alignTop="@id/shipping_discount_label"
                    android:text="-₱0.00"
                    android:textColor="#FF4149" />

                <View
                    android:id="@+id/summary_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@id/shipping_discount_label"
                    android:layout_marginTop="10dp"
                    android:background="#BBBBBB" />

                <TextView
                    android:id="@+id/total_label"
                    style="@style/CartSummaryHeading"
                    android:layout_below="@id/summary_divider"
                    android:layout_marginTop="8dp"
                    android:text="Total" />

                <TextView
                    android:id="@+id/cart_total"
                    style="@style/CartSummaryAmount"
                    android:layout_alignTop="@id/total_label"
                    android:text="₱0.00"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cart_checkout"
                    android:layout_width="200dp"
                    android:layout_height="48dp"
                    android:layout_below="@id/total_label"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/cart_red_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="CHECK OUT"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cart_clear"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:layout_below="@id/cart_checkout"
                    android:layout_centerHorizontal="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Clear cart"
                    android:textColor="#FF4149"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>