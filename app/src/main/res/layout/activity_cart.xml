<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FA"
    tools:context=".cart">

    <!-- BOTTOM NAVIGATION -->
    <RelativeLayout
        android:id="@+id/cart_navigation"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/cart_bottom_bar"
        android:elevation="10dp">

        <View
            android:id="@+id/nav_center"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerInParent="true" />

        <View
            android:id="@+id/nav_left_center"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/nav_center" />

        <View
            android:id="@+id/nav_right_center"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/nav_center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- HOME -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/cart_nav_home"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Home"
                    android:padding="12dp"
                    android:src="@drawable/ic_home"
                    app:tint="#89838C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="#89838C"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- OFFERS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/cart_nav_perfumes"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Offers"
                    android:padding="12dp"
                    android:src="@drawable/ic_gift"
                    app:tint="#89838C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offers"
                    android:textColor="#89838C"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- CART -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/cart_nav_cart"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/cart_selected_nav"
                    android:contentDescription="Cart, selected"
                    android:padding="12dp"
                    android:src="@drawable/ic_cart"
                    app:tint="#E84E78" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cart"
                    android:textColor="#E84E78"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PROFILE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/cart_nav_profile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Profile"
                    android:padding="12dp"
                    android:src="@drawable/ic_profile"
                    app:tint="#89838C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textColor="#89838C"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <!-- MAIN CART SCROLL CONTENT -->
    <ScrollView
        android:id="@+id/cart_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/cart_navigation"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- HEADER -->
            <RelativeLayout
                android:id="@+id/cart_header"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="@drawable/cart_header_gradient"
                android:padding="16dp">

                <!-- BACK BUTTON -->
                <ImageButton
                    android:id="@+id/cart_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/cart_selected_nav"
                    android:contentDescription="Go back"
                    android:padding="12dp"
                    android:src="@drawable/ic_back"
                    app:tint="#C63A65" />

                <!-- APP BRAND -->
                <TextView
                    android:id="@+id/cart_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="serif"
                    android:text="ChaChix"
                    android:textColor="#9F254E"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/cart_brand"
                    android:layout_centerHorizontal="true"
                    android:letterSpacing="0.24"
                    android:text="SCENTS"
                    android:textColor="#BB4168"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- PAGE TITLE -->
                <TextView
                    android:id="@+id/cart_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="28dp"
                    android:fontFamily="serif"
                    android:text="My Cart"
                    android:textColor="#4A2030"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cart_subheading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:text="Your favorite scents are waiting!"
                    android:textColor="#815769"
                    android:textSize="12sp" />

            </RelativeLayout>

            <!-- CART ITEMS SECTION TITLE -->
            <TextView
                android:id="@+id/cart_items_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/cart_header"
                android:layout_marginTop="20dp"
                android:text="Items in your bag"
                android:textColor="#2C2430"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- CART PRODUCTS CONTAINER -->
            <RelativeLayout
                android:id="@+id/cart_products"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/cart_items_label"
                android:layout_marginTop="10dp"
                android:background="@drawable/cart_surface_card"
                android:elevation="2dp"
                android:padding="14dp">

                <!-- PRODUCTS GENERATED BY JAVA -->
                <RelativeLayout
                    android:id="@+id/cart_items_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- EMPTY CART MESSAGE -->
                <TextView
                    android:id="@+id/cart_empty"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_below="@id/cart_items_container"
                    android:drawableTop="@drawable/ic_cart"
                    android:drawablePadding="14dp"
                    android:drawableTint="#EC8BA6"
                    android:gravity="center"
                    android:text="Your cart is empty&#10;Explore perfumes to find your favorite scent"
                    android:textColor="#827681"
                    android:textSize="13sp"
                    android:lineSpacingExtra="5dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </RelativeLayout>

            <!-- ORDER SUMMARY -->
            <RelativeLayout
                android:id="@+id/cart_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/cart_products"
                android:layout_marginTop="16dp"
                android:background="@drawable/cart_surface_card"
                android:elevation="2dp"
                android:padding="18dp">

                <!-- SUMMARY TITLE -->
                <TextView
                    android:id="@+id/summary_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Summary"
                    android:textColor="#29212C"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- PRODUCT SUBTOTAL -->
                <TextView
                    android:id="@+id/product_subtotal_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/summary_heading"
                    android:layout_marginTop="18dp"
                    android:text="Product subtotal"
                    android:textColor="#605661"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/cart_subtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/product_subtotal_label"
                    android:layout_alignParentEnd="true"
                    android:text="₱0.00"
                    android:textColor="#29212C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- ORIGINAL PRICE -->
                <TextView
                    android:id="@+id/original_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/product_subtotal_label"
                    android:layout_marginTop="12dp"
                    android:text="Original price"
                    android:textColor="#857A85"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/cart_original"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/original_label"
                    android:layout_alignParentEnd="true"
                    android:text="₱0.00"
                    android:textColor="#605661"
                    android:textSize="13sp" />

                <!-- PRODUCT DISCOUNT -->
                <TextView
                    android:id="@+id/discount_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/original_label"
                    android:layout_marginTop="12dp"
                    android:text="Product discount"
                    android:textColor="#857A85"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/cart_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/discount_label"
                    android:layout_alignParentEnd="true"
                    android:text="-₱0.00"
                    android:textColor="#E84E78"
                    android:textSize="13sp" />

                <!-- SHIPPING -->
                <TextView
                    android:id="@+id/shipping_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/discount_label"
                    android:layout_marginTop="20dp"
                    android:text="Shipping"
                    android:textColor="#29212C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- SHIPPING FEE -->
                <TextView
                    android:id="@+id/shipping_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/shipping_heading"
                    android:layout_marginTop="12dp"
                    android:text="Shipping fee"
                    android:textColor="#857A85"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/cart_shipping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/shipping_label"
                    android:layout_alignParentEnd="true"
                    android:text="₱0.00"
                    android:textColor="#605661"
                    android:textSize="13sp" />

                <!-- SHIPPING DISCOUNT -->
                <TextView
                    android:id="@+id/shipping_discount_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/shipping_label"
                    android:layout_marginTop="12dp"
                    android:text="Shipping discount"
                    android:textColor="#857A85"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/cart_shipping_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/shipping_discount_label"
                    android:layout_alignParentEnd="true"
                    android:text="-₱0.00"
                    android:textColor="#E84E78"
                    android:textSize="13sp" />

                <!-- DIVIDER -->
                <View
                    android:id="@+id/summary_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@id/shipping_discount_label"
                    android:layout_marginTop="18dp"
                    android:background="#F0E4E9" />

                <!-- TOTAL -->
                <TextView
                    android:id="@+id/total_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/summary_divider"
                    android:layout_marginTop="16dp"
                    android:text="Total"
                    android:textColor="#29212C"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cart_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBaseline="@id/total_label"
                    android:layout_alignParentEnd="true"
                    android:text="₱0.00"
                    android:textColor="#E84E78"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <!-- CHECKOUT BUTTON -->
                <TextView
                    android:id="@+id/cart_checkout"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_below="@id/total_label"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/cart_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="CHECK OUT  →"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- CLEAR CART -->
                <TextView
                    android:id="@+id/cart_clear"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_below="@id/cart_checkout"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Clear cart"
                    android:textColor="#D94C74"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>
