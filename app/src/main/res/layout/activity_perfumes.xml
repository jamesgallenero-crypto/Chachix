<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/perfumes_background">

    <!-- Bottom navigation -->
    <RelativeLayout
        android:id="@+id/perfumes_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/home_navigation_background">

        <View
            android:id="@+id/perfumes_nav_center"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerHorizontal="true" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/perfumes_nav_center">

            <View
                android:id="@+id/perfumes_nav_left_center"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_centerHorizontal="true" />

            <ImageButton
                android:id="@+id/perfumes_nav_home"
                style="@style/PerfumesNavigationButton"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/perfumes_nav_left_center"
                android:contentDescription="Home"
                android:src="@drawable/ic_home" />

            <ImageButton
                android:id="@+id/perfumes_nav_catalog"
                style="@style/PerfumesNavigationButton"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/perfumes_nav_left_center"
                android:contentDescription="Perfumes"
                android:src="@drawable/ic_gift" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/perfumes_nav_center">

            <View
                android:id="@+id/perfumes_nav_right_center"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_centerHorizontal="true" />

            <ImageButton
                android:id="@+id/perfumes_nav_cart"
                style="@style/PerfumesNavigationButton"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/perfumes_nav_right_center"
                android:contentDescription="Cart"
                android:src="@drawable/ic_cart" />

            <ImageButton
                android:id="@+id/perfumes_nav_profile"
                style="@style/PerfumesNavigationButton"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@id/perfumes_nav_right_center"
                android:contentDescription="Profile"
                android:src="@drawable/ic_profile" />

        </RelativeLayout>

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@id/perfumes_navigation"
        android:fillViewport="true"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Brand -->
            <RelativeLayout
                android:id="@+id/perfumes_header"
                android:layout_width="match_parent"
                android:layout_height="100dp">

                <ImageButton
                    android:id="@+id/perfumes_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_back_button"
                    android:contentDescription="Go back"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_back" />
                <TextView
                    android:id="@+id/perfumes_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="14dp"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:text="ChaChix"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/perfumes_brand"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:text="Scents"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <TextView
                android:id="@+id/perfumes_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/perfumes_header"
                android:layout_marginStart="4dp"
                android:text="Perfume’s"
                android:textColor="#FFFFFF"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/perfumes_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/perfumes_title"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:text="Leave a Trace They’ll Remember!"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <!-- Search -->
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/perfumes_search"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_below="@id/perfumes_subtitle"
                android:layout_marginTop="20dp"
                android:background="@drawable/home_search_background"
                android:backgroundTint="@null"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:drawableTint="#333333"
                android:elevation="2dp"
                android:hint="Search product..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#777777"
                android:textSize="12sp" />

            <!-- Product grid -->
            <RelativeLayout
                android:id="@+id/perfumes_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/perfumes_search"
                android:layout_marginTop="18dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/perfumes_grid_center"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:layout_centerHorizontal="true" />

                <!-- SCENTRICITY -->
                <RelativeLayout
                    android:id="@+id/scentricity_card"
                    style="@style/PerfumesProductCard"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="14dp"
                    android:layout_toStartOf="@id/perfumes_grid_center">

                    <ImageView
                        android:id="@+id/scentricity_photo"
                        style="@style/PerfumesProductImage"
                        android:contentDescription="Scentricity perfume"
                        android:src="@drawable/product1" />

                    <TextView
                        android:id="@+id/scentricity_title"
                        style="@style/PerfumesProductTitle"
                        android:layout_below="@id/scentricity_photo"
                        android:text="SCENTRICITY Scent Unisex - 20% oil fragrance concentration..." />

                    <TextView
                        android:id="@+id/scentricity_price"
                        style="@style/PerfumesProductPrice"
                        android:layout_below="@id/scentricity_title"
                        android:text="₱499" />

                    <TextView
                        android:id="@+id/scentricity_offer"
                        style="@style/PerfumesProductOffer"
                        android:layout_below="@id/scentricity_price"
                        android:text="LIVE OFF" />

                    <TextView
                        style="@style/PerfumesProductRating"
                        android:layout_below="@id/scentricity_offer"
                        android:text="★ 5.0 | 5.2K sold" />

                </RelativeLayout>

                <!-- RICHY -->
                <RelativeLayout
                    android:id="@+id/richy_card"
                    style="@style/PerfumesProductCard"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="14dp"
                    android:layout_toEndOf="@id/perfumes_grid_center">

                    <ImageView
                        android:id="@+id/richy_photo"
                        style="@style/PerfumesProductImage"
                        android:contentDescription="Richy perfume"
                        android:src="@drawable/product2" />

                    <TextView
                        android:id="@+id/richy_title"
                        style="@style/PerfumesProductTitle"
                        android:layout_below="@id/richy_photo"
                        android:text="Richy Scent Unisex - 20% oil fragrance concentration..." />

                    <TextView
                        android:id="@+id/richy_price"
                        style="@style/PerfumesProductPrice"
                        android:layout_below="@id/richy_title"
                        android:text="₱499" />

                    <TextView
                        android:id="@+id/richy_offer"
                        style="@style/PerfumesProductOffer"
                        android:layout_below="@id/richy_price"
                        android:text="LIVE OFF" />

                    <TextView
                        style="@style/PerfumesProductRating"
                        android:layout_below="@id/richy_offer"
                        android:text="★ 5.0 | 5.2K sold" />

                </RelativeLayout>

                <!-- Align the next row below the taller first-row card -->
                <View
                    android:id="@+id/perfumes_second_row_anchor"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:layout_below="@id/scentricity_card"
                    android:layout_alignBottom="@id/richy_card" />

                <!-- LUMINOUS -->
                <RelativeLayout
                    android:id="@+id/luminous_card"
                    style="@style/PerfumesProductCard"
                    android:layout_below="@id/perfumes_second_row_anchor"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="14dp"
                    android:layout_toStartOf="@id/perfumes_grid_center">

                    <ImageView
                        android:id="@+id/luminous_photo"
                        style="@style/PerfumesProductImage"
                        android:contentDescription="Luminous perfume"
                        android:src="@drawable/product3" />

                    <TextView
                        android:id="@+id/luminous_title"
                        style="@style/PerfumesProductTitle"
                        android:layout_below="@id/luminous_photo"
                        android:text="LUMINOUS Scent Unisex - 20% oil fragrance concentration..." />

                    <TextView
                        android:id="@+id/luminous_price"
                        style="@style/PerfumesProductPrice"
                        android:layout_below="@id/luminous_title"
                        android:text="₱499" />

                    <TextView
                        android:id="@+id/luminous_offer"
                        style="@style/PerfumesProductOffer"
                        android:layout_below="@id/luminous_price"
                        android:text="LIVE OFF" />

                    <TextView
                        style="@style/PerfumesProductRating"
                        android:layout_below="@id/luminous_offer"
                        android:text="★ 5.0 | 5.2K sold" />

                </RelativeLayout>

                <!-- KELSEY -->
                <RelativeLayout
                    android:id="@+id/kelsey_card"
                    style="@style/PerfumesProductCard"
                    android:layout_below="@id/perfumes_second_row_anchor"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="14dp"
                    android:layout_toEndOf="@id/perfumes_grid_center">

                    <ImageView
                        android:id="@+id/kelsey_photo"
                        style="@style/PerfumesProductImage"
                        android:contentDescription="Kelsey perfume"
                        android:src="@drawable/product4" />

                    <TextView
                        android:id="@+id/kelsey_title"
                        style="@style/PerfumesProductTitle"
                        android:layout_below="@id/kelsey_photo"
                        android:text="KELSEY Scent Unisex - 20% oil fragrance concentration..." />

                    <TextView
                        android:id="@+id/kelsey_price"
                        style="@style/PerfumesProductPrice"
                        android:layout_below="@id/kelsey_title"
                        android:text="₱499" />

                    <TextView
                        android:id="@+id/kelsey_offer"
                        style="@style/PerfumesProductOffer"
                        android:layout_below="@id/kelsey_price"
                        android:text="LIVE OFF" />

                    <TextView
                        style="@style/PerfumesProductRating"
                        android:layout_below="@id/kelsey_offer"
                        android:text="★ 5.0 | 5.2K sold" />

                </RelativeLayout>

                <View
                    android:id="@+id/perfumes_third_row_anchor"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:layout_below="@id/luminous_card"
                    android:layout_alignBottom="@id/kelsey_card" />

                <!-- Centered final product -->
                <RelativeLayout
                    android:id="@+id/candice_card"
                    style="@style/PerfumesProductCard"
                    android:layout_width="132dp"
                    android:layout_below="@id/perfumes_third_row_anchor"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="24dp">

                    <ImageView
                        android:id="@+id/candice_photo"
                        style="@style/PerfumesProductImage"
                        android:contentDescription="Candice perfume"
                        android:src="@drawable/product5" />

                    <TextView
                        android:id="@+id/candice_title"
                        style="@style/PerfumesProductTitle"
                        android:layout_below="@id/candice_photo"
                        android:text="Candice Scent Unisex - 20% oil fragrance concentration..." />

                    <TextView
                        android:id="@+id/candice_price"
                        style="@style/PerfumesProductPrice"
                        android:layout_below="@id/candice_title"
                        android:text="₱499" />

                    <TextView
                        android:id="@+id/candice_offer"
                        style="@style/PerfumesProductOffer"
                        android:layout_below="@id/candice_price"
                        android:text="LIVE OFF" />

                    <TextView
                        style="@style/PerfumesProductRating"
                        android:layout_below="@id/candice_offer"
                        android:text="★ 5.0 | 5.2K sold" />

                </RelativeLayout>

            </RelativeLayout>

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>