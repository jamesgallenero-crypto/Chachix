<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="190dp"
    android:background="@drawable/bg_product"
    android:padding="7dp">

    <ImageView
        android:id="@+id/productImage"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_alignParentTop="true"
        android:contentDescription="Perfume"
        android:scaleType="fitCenter"
        android:src="@drawable/product4" />

    <TextView
        android:id="@+id/favoriteButton"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:gravity="center"
        android:text="♥"
        android:textColor="#DF2525"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/productName"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_below="@id/productImage"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Kelsey Scent Unisex - 20% oil fragrance concentration..."
        android:textColor="#111111"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/productPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/productName"
        android:text="₱499"
        android:textColor="#FF424D"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/productDiscount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/productPrice"
        android:background="#FFB3A1"
        android:paddingHorizontal="3dp"
        android:text="-15%"
        android:textColor="#E64E37"
        android:textSize="7sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/productDiscount"
        android:layout_marginTop="2dp"
        android:text="⭐ 5.0 | 5.2K sold"
        android:textColor="#888888"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/addToCart"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_cart_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="🛒   Add to cart"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />
</RelativeLayout>