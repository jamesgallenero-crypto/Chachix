
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F8"
    tools:context=".MainActivity">

    <!-- SCROLLABLE LOGIN SCREEN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- BRAND HEADER -->
            <RelativeLayout
                android:id="@+id/brand_header"
                android:layout_width="match_parent"
                android:layout_height="158dp"
                android:background="@drawable/chachix_login_header"
                android:padding="16dp">

                <TextView
                    android:id="@+id/brand_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="ChaChix"
                    android:textColor="#822747"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/brand_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/brand_name"
                    android:layout_marginTop="1dp"
                    android:gravity="center"
                    android:letterSpacing="0.28"
                    android:text="SCENTS"
                    android:textColor="#AC476A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/brand_subtitle"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Find a scent that feels like you"
                    android:textColor="#916575"
                    android:textSize="12sp" />

            </RelativeLayout>

            <!-- LOGIN CARD -->
            <RelativeLayout
                android:id="@+id/login_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/chachix_login_card"
                android:elevation="3dp"
                android:paddingStart="22dp"
                android:paddingTop="24dp"
                android:paddingEnd="22dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- LOGIN HEADING -->
                    <TextView
                        android:id="@+id/login_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="Welcome"
                        android:textColor="#70243F"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Sign in to your ChaChix account"
                        android:textColor="#927F88"
                        android:textSize="13sp" />

                    <!-- USERNAME LABEL -->
                    <TextView
                        android:id="@+id/username_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:labelFor="@id/username"
                        android:text="Username"
                        android:textColor="#513944"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- USERNAME INPUT -->
                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/username"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/chachix_login_input"
                        android:backgroundTint="@null"
                        android:autofillHints="username"
                        android:hint="Enter your username"
                        android:imeOptions="actionNext"
                        android:inputType="textNoSuggestions"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="#402934"
                        android:textColorHint="#A99AA2"
                        android:textSize="14sp" />

                    <!-- PASSWORD LABEL -->
                    <TextView
                        android:id="@+id/password_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:labelFor="@id/password"
                        android:text="Password"
                        android:textColor="#513944"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- PASSWORD INPUT -->
                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/chachix_login_input"
                        android:backgroundTint="@null"
                        android:autofillHints="password"
                        android:hint="Enter your password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="#402934"
                        android:textColorHint="#A99AA2"
                        android:textSize="14sp" />

                    <!-- FORGOT PASSWORD -->
                    <TextView
                        android:id="@+id/forgot_password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical|end"
                        android:text="Forgot password?"
                        android:textColor="#D64C78"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- LOGIN BUTTON -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/login_button"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/chachix_login_primary"
                        android:backgroundTint="@null"
                        app:backgroundTint="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="Sign In"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- CREATE ACCOUNT -->
                    <TextView
                        android:id="@+id/create_account"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="New to ChaChix? Create an account"
                        android:textColor="#B93F68"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- SOCIAL LOGIN DIVIDER -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#EBDDE4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="Or continue with"
                            android:textColor="#9B8993"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#EBDDE4" />

                    </LinearLayout>

                    <!-- SOCIAL LOGIN BUTTONS -->
                    <RelativeLayout
                        android:id="@+id/social_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <!-- FACEBOOK -->
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/facebook_button"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/chachix_login_social"
                                android:backgroundTint="@null"
                                app:backgroundTint="@null"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:text="Facebook"
                                android:textAllCaps="false"
                                android:textColor="#5F4855"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:contentDescription="Facebook sign-in" />

                            <!-- GOOGLE -->
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/google_button"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:background="@drawable/chachix_login_social"
                                android:backgroundTint="@null"
                                app:backgroundTint="@null"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:text="Google"
                                android:textAllCaps="false"
                                android:textColor="#5F4855"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:contentDescription="Google sign-in" />

                        </LinearLayout>
                    </RelativeLayout>

                </LinearLayout>
            </RelativeLayout>

            <!-- FOOTER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="ChaChix Scents PH"
                android:textColor="#A88492"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
