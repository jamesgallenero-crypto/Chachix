<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FA"
    tools:context=".Profile">

    <RelativeLayout
        android:id="@+id/profile_navigation"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/cart_bottom_bar"
        android:elevation="10dp">

        <View
            android:id="@+id/profile_nav_center"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerInParent="true"
            android:visibility="gone" />

        <View
            android:id="@+id/profile_nav_left_center"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/profile_nav_center"
            android:visibility="gone" />

        <View
            android:id="@+id/profile_nav_right_center"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/profile_nav_center"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <!-- HOME -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/profile_nav_home"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Home"
                    android:padding="12dp"
                    android:src="@drawable/ic_home"
                    app:tint="#89838C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="#89838C"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- OFFERS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/profile_nav_offers"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Offers"
                    android:padding="12dp"
                    android:src="@drawable/ic_gift"
                    app:tint="#89838C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offers"
                    android:textColor="#89838C"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- CART -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/profile_nav_cart"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cart"
                    android:padding="12dp"
                    android:src="@drawable/ic_cart"
                    app:tint="#89838C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cart"
                    android:textColor="#89838C"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- PROFILE: selected -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/profile_nav_profile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/cart_selected_nav"
                    android:contentDescription="Profile, selected"
                    android:padding="12dp"
                    android:src="@drawable/ic_profile"
                    app:tint="#E84E78" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textColor="#E84E78"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:id="@+id/profile_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/profile_navigation"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <RelativeLayout
                android:id="@+id/profile_header"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:background="@drawable/profile_header_gradient"
                android:elevation="2dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/profile_user_initials"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/home_circle"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#DC5074"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="GG" />

                <ImageButton
                    android:id="@+id/profile_settings"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings"
                    android:padding="11dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/profile_favorites"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/profile_settings"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Wishlist"
                    android:padding="12dp"
                    android:src="@drawable/ic_heart"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="2dp"
                    android:layout_toEndOf="@id/profile_user_initials"
                    android:layout_toStartOf="@id/profile_favorites"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_user_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Loading..."
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="James Gallenero" />

                    <TextView
                        android:id="@+id/profile_user_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FFF3F6"
                        android:textSize="12sp"
                        tools:text="Davao City, Davao del Sur" />

                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/purchases_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/profile_soft_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/purchases_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Purchases"
                            android:textColor="#24232A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Track your orders"
                            android:textColor="#8A8790"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/purchase_history"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:text="View all  ›"
                        android:textColor="#E94C76"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/to_pay"
                        style="@style/ProfilePurchaseItem"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/ic_receipt"
                        android:drawablePadding="10dp"
                        android:gravity="center"
                        android:text="To pay"
                        android:textColor="#34323A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/to_ship"
                        style="@style/ProfilePurchaseItem"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/ic_receipt"
                        android:drawablePadding="10dp"
                        android:gravity="center"
                        android:text="To ship"
                        android:textColor="#34323A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/to_receive"
                        style="@style/ProfilePurchaseItem"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/ic_delivery"
                        android:drawablePadding="10dp"
                        android:gravity="center"
                        android:text="To receive"
                        android:textColor="#34323A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/to_rate"
                        style="@style/ProfilePurchaseItem"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/ic_rating"
                        android:drawablePadding="10dp"
                        android:gravity="center"
                        android:text="To rate"
                        android:textColor="#34323A"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wishlist_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/profile_soft_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:id="@+id/wishlist_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:contentDescription="Wishlist"
                        android:src="@drawable/ic_heart"
                        app:tint="#EF6D8A" />

                    <TextView
                        android:id="@+id/wishlist_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@id/wishlist_icon"
                        android:text="My Wishlist"
                        android:textColor="#24232A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/view_wishlist"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:text="View all  ›"
                        android:textColor="#E94C76"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/wishlist_one"
                            layout="@layout/wishlist_product"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp" />

                        <include
                            android:id="@+id/wishlist_two"
                            layout="@layout/wishlist_product"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/wishlist_three"
                            layout="@layout/wishlist_product"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp" />

                        <include
                            android:id="@+id/wishlist_four"
                            layout="@layout/wishlist_product"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>