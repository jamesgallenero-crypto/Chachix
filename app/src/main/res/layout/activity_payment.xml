<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F9"
    tools:context=".payment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- CHECKOUT HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/payment_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/payment_ui_icon_background"
                android:contentDescription="Go back"
                android:padding="14dp"
                android:src="@drawable/ic_back"
                app:tint="#A83C60" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="serif"
                android:text="Checkout"
                android:textColor="#642B40"
                android:textSize="23sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- SCROLLABLE CONTENT -->
        <ScrollView
            android:id="@+id/payment_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="28dp">

                <!-- DELIVERY INFORMATION -->
                <RelativeLayout
                    android:id="@+id/payment_delivery_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/payment_ui_card"
                    android:elevation="2dp"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/delivery_heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_delivery"
                        android:drawablePadding="10dp"
                        android:drawableTint="#DB4F7B"
                        android:gravity="center_vertical"
                        android:text="Delivery information"
                        android:textColor="#54283A"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/delivery_divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@id/delivery_heading"
                        android:layout_marginTop="14dp"
                        android:background="#F2E4EA" />

                    <!-- FIREBASE RECIPIENT -->
                    <TextView
                        android:id="@+id/payment_recipient"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/delivery_divider"
                        android:layout_marginTop="14dp"
                        android:text="Loading delivery information..."
                        android:textColor="#392E36"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Gabriel Gallenero  09123456789" />

                    <!-- FIREBASE ADDRESS -->
                    <TextView
                        android:id="@+id/payment_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/payment_recipient"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#83717C"
                        android:textSize="13sp"
                        tools:text="Rizal Street&#10;Davao City, Davao del Sur 8000" />

                </RelativeLayout>

                <!-- PRODUCTS HEADING -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:text="Your items"
                    android:textColor="#642B40"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- SELECTED PRODUCTS -->
                <RelativeLayout
                    android:id="@+id/payment_products"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/payment_ui_card"
                    android:elevation="2dp"
                    android:padding="14dp">

                    <!-- PRODUCTS LOADED BY JAVA -->
                    <RelativeLayout
                        android:id="@+id/payment_items_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- EMPTY PRODUCTS -->
                    <TextView
                        android:id="@+id/payment_empty"
                        android:layout_width="match_parent"
                        android:layout_height="104dp"
                        android:layout_below="@id/payment_items_container"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp"
                        android:text="No products selected&#10;Add a perfume to continue"
                        android:textColor="#9A8993"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </RelativeLayout>

                <!-- ORDER SUMMARY CARD -->
                <RelativeLayout
                    android:id="@+id/payment_summary_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/payment_ui_card"
                    android:elevation="2dp"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- ORDER SUMMARY TITLE -->
                        <TextView
                            android:id="@+id/payment_summary_heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Order summary"
                            android:textColor="#54283A"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- PRODUCT SUBTOTAL -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/payment_subtotal_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Product subtotal"
                                android:textColor="#665965"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/payment_subtotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00"
                                android:textColor="#332B33"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- ORIGINAL PRICE -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/payment_original_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Original price"
                                android:textColor="#83717C"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/payment_original"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00"
                                android:textColor="#665965"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- PRODUCT DISCOUNT -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/payment_discount_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Product discount"
                                android:textColor="#83717C"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/payment_discount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-₱0.00"
                                android:textColor="#DE4D78"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- SHIPPING SUBTOTAL -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/payment_shipping_heading"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Shipping subtotal"
                                android:textColor="#54283A"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/payment_shipping_subtotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00"
                                android:textColor="#332B33"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- SHIPPING FEE -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/payment_shipping_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Shipping fee"
                                android:textColor="#83717C"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/payment_shipping"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00"
                                android:textColor="#665965"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- SHIPPING DISCOUNT -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/payment_shipping_discount_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Shipping discount"
                                android:textColor="#83717C"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/payment_shipping_discount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-₱0.00"
                                android:textColor="#DE4D78"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- DIVIDER -->
                        <View
                            android:id="@+id/payment_summary_divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="18dp"
                            android:background="#EEDFE5" />

                        <!-- CALCULATED TOTAL -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/payment_total_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Total"
                                android:textColor="#442A37"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/payment_summary_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱0.00"
                                android:textColor="#DB4472"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- PAYMENT METHOD TITLE -->
                        <TextView
                            android:id="@+id/payment_method_heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:text="Payment method"
                            android:textColor="#54283A"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="6dp"
                            android:text="Select your preferred payment option"
                            android:textColor="#988791"
                            android:textSize="12sp" />

                        <!-- CASH ON DELIVERY -->
                        <RelativeLayout
                            android:id="@+id/payment_cod_row"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/payment_ui_option">

                            <TextView
                                android:layout_width="42dp"
                                android:layout_height="30dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/payment_ui_cod_badge"
                                android:gravity="center"
                                android:text="COD"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <RadioButton
                                android:id="@+id/payment_cod"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="62dp"
                                android:layout_marginEnd="14dp"
                                android:button="@null"
                                android:checked="true"
                                android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:text="Cash on delivery"
                                android:textColor="#493441"
                                android:textSize="13sp" />

                        </RelativeLayout>

                        <!-- CREDIT OR DEBIT CARD -->
                        <RelativeLayout
                            android:id="@+id/payment_card_row"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/payment_ui_option">

                            <TextView
                                android:layout_width="42dp"
                                android:layout_height="30dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/payment_ui_card_badge"
                                android:gravity="center"
                                android:text="CARD"
                                android:textColor="#FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <RadioButton
                                android:id="@+id/payment_card"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="62dp"
                                android:layout_marginEnd="14dp"
                                android:button="@null"
                                android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:text="Credit / debit card"
                                android:textColor="#493441"
                                android:textSize="13sp" />

                        </RelativeLayout>

                        <!-- GCASH -->
                        <RelativeLayout
                            android:id="@+id/payment_gcash_row"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/payment_ui_option">

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="15dp"
                                android:background="@drawable/payment_gcash_background"
                                android:gravity="center"
                                android:text="G"
                                android:textColor="#FFFFFF"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <RadioButton
                                android:id="@+id/payment_gcash"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="62dp"
                                android:layout_marginEnd="14dp"
                                android:button="@null"
                                android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:text="GCash"
                                android:textColor="#493441"
                                android:textSize="13sp" />

                        </RelativeLayout>

                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>

        </ScrollView>

        <!-- FIXED PLACE ORDER FOOTER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="114dp"
            android:background="@drawable/payment_ui_footer"
            android:elevation="10dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <!-- ITEM COUNT -->
            <TextView
                android:id="@+id/payment_item_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Total (0 items)"
                android:textColor="#5B3A49"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- FINAL TOTAL -->
            <TextView
                android:id="@+id/payment_bottom_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="₱0.00"
                android:textColor="#DC4172"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- PLACE ORDER -->
            <TextView
                android:id="@+id/payment_place_order"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/payment_ui_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Place order"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
