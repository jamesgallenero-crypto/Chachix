<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF89A3"
    tools:context=".product5">

    <!-- Fixed bottom buttons -->
    <RelativeLayout
        android:id="@+id/product_actions"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_alignParentBottom="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/detail_add_to_cart"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_cart_button"
            android:contentDescription="Add to cart"
            android:padding="13dp"
            android:src="@drawable/ic_cart"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/detail_buy_now"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_toEndOf="@id/detail_add_to_cart"
            android:background="@drawable/home_search_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="BUY NOW\nFlash sale ₱299"
            android:textColor="#FF526C"
            android:textSize="14sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Scrollable product content -->
    <ScrollView
        android:id="@+id/product_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@id/product_actions"
        android:fillViewport="true"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <!-- Main product photo -->
            <RelativeLayout
                android:id="@+id/detail_photo_card"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:background="@drawable/home_search_background">

                <ImageView
                    android:id="@+id/detail_product_image"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="16dp"
                    android:contentDescription="Candice perfume"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/product5" />

                <!-- Plain triangle back button -->
                <ImageButton
                    android:id="@+id/detail_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/home_circle_red"
                    android:contentDescription="Go back"
                    android:padding="9dp"
                    android:src="@drawable/ic_back"
                    android:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/detail_price"
                    android:layout_width="92dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="26dp"
                    android:background="@drawable/bg_detail_price"
                    android:gravity="center"
                    android:text="₱499"
                    android:textColor="#FF4149"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Carousel dots: visual only -->
                <RelativeLayout
                    android:layout_width="64dp"
                    android:layout_height="18dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/active_image_dot"
                        android:layout_width="12dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="#222222"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@id/active_image_dot"
                        android:gravity="center"
                        android:text="● ● ● ●"
                        android:textColor="#D8D8D8"
                        android:textSize="10sp" />

                </RelativeLayout>

            </RelativeLayout>

            <!-- Product information -->
            <RelativeLayout
                android:id="@+id/detail_information_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/detail_photo_card"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_white_card"
                android:padding="12dp">

                <ImageButton
                    android:id="@+id/detail_favorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Add to wishlist"
                    android:padding="10dp"
                    android:src="@drawable/ic_detail_heart" />

                <TextView
                    android:id="@+id/detail_product_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_toStartOf="@id/detail_favorite"
                    android:text="CANDICE Scent Unisex - 20% oil fragrance concentration | Chachix Scent long lasting Perfumes 100ML, 50ML, 30ML, 10ML"
                    android:textColor="#111111"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_rating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detail_product_title"
                    android:layout_marginTop="10dp"
                    android:text="★ 5.0 (100) | 5.2K sold"
                    android:textColor="#A17E54"
                    android:textSize="10sp" />

                <!-- Customer reviews -->
                <RelativeLayout
                    android:id="@+id/detail_reviews_header"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_below="@id/detail_rating"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@id/detail_see_reviews"
                        android:gravity="center_vertical"
                        android:text="Customer reviews (1.1K)"
                        android:textColor="#222222"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detail_see_reviews"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="See more ›"
                        android:textColor="#888888"
                        android:textSize="9sp" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/detail_review_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detail_reviews_header"
                    android:text="5/5  ★★★★★"
                    android:textColor="#F2AD22"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/detail_reviewer_avatar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_below="@id/detail_review_stars"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:tint="#C9C9C9" />

                <TextView
                    android:id="@+id/detail_reviewer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_below="@id/detail_review_stars"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_toEndOf="@id/detail_reviewer_avatar"
                    android:gravity="center_vertical"
                    android:text="Ca*da"
                    android:textColor="#333333"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/detail_review_attributes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detail_reviewer_avatar"
                    android:layout_marginTop="6dp"
                    android:text="Item: Kelsey\nProduct quality: 10/10"
                    android:textColor="#999999"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/detail_review_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/detail_review_attributes"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="Humot kaayo ang Candice dili sakit sa ilong"
                    android:textColor="#333333"
                    android:textSize="11sp" />

            </RelativeLayout>

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>