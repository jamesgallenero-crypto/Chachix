<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <corners android:radius="13dp" />
            <solid android:color="#A9334A" />
        </shape>
    </item>

    <item
        android:top="3dp"
        android:left="1dp"
        android:right="1dp">

        <shape>
            <corners android:radius="12dp" />
            <gradient
                android:angle="0"
                android:startColor="#D66578"
                android:endColor="#D13D57" />
        </shape>

    </item>

</layer-list>