<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <corners android:radius="26dp" />
            <solid android:color="#BA6C83" />
        </shape>
    </item>

    <item
        android:top="3dp"
        android:left="1dp"
        android:right="1dp">

        <shape>
            <corners android:radius="25dp" />
            <gradient
                android:angle="0"
                android:startColor="#F8B2C9"
                android:centerColor="#FA86AD"
                android:endColor="#F86595" />
        </shape>

    </item>

</layer-list>